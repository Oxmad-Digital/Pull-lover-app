DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=pull-lover

# E-mails (Plunk) — tous les e-mails du site : transactionnels, contact, notifications admin.
# Clé secrète côté serveur uniquement ; l'expéditeur doit être un domaine vérifié dans Plunk.
PLUNK_SECRET_KEY=sk_your-plunk-secret-key
PLUNK_PUBLIC_KEY=pk_your-plunk-public-key
PLUNK_FROM_EMAIL=contact@your-verified-domain.com
PLUNK_FROM_NAME=Pull-Lover
# Destinataire du formulaire de contact + adresse de réponse des e-mails clients
CONTACT_EMAIL=contact@your-domain.com
# Destinataire des notifications de commande et alertes (défaut : CONTACT_EMAIL)
ADMIN_EMAIL=admin@your-domain.com
